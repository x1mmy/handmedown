# Public Supabase project. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://gknpxsexkmkhomsclpwi.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Ukt22QIdumZcUZ2jEvVvhA_7DrmXxPt

# Server-only. Never commit a real value. Required for private storage uploads
# once HMD_DATA_ADAPTER=supabase. Leave blank in local demo mode.
SUPABASE_SECRET_KEY=

# demo is an explicit local opt-in. Unset or any other value is supabase,
# which fails loudly unless the URL, publishable key, and secret key are set.
# There is no silent demo fallback. Do not apply migrations to the remote project.
HMD_DATA_ADAPTER=demo

# The one book this server will read or write. Defaults to the seeded Fam book.
# HMD_BOOK_ID=10000000-0000-4000-8000-000000000001
