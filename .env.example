# Copy to .env (gitignored) and fill in SUPABASE_SECRET_KEY.
# These are the only variables the app reads.

# Supabase project. Public, safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://gknpxsexkmkhomsclpwi.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Ukt22QIdumZcUZ2jEvVvhA_7DrmXxPt

# Server only. Never commit a real value. The app will not start without it.
# Supabase dashboard > Project Settings > API Keys > Secret keys (starts with sb_secret_).
SUPABASE_SECRET_KEY=

# Optional. UUID of the one family book. Defaults to the book the migration seeds ("The Fam").
# HMD_BOOK_ID=10000000-0000-4000-8000-000000000001

# Optional. "off" hides PDF download and uses the browser print dialog.
# Always off on Vercel. Locally it needs: npx playwright install chromium
# HMD_PDF_EXPORT=off
